sequenceDiagram
    autonumber
    actor p0 as client
    participant p1 as auth.auth
    participant p2 as auth-pg
    participant p3 as bus
    participant p4 as risk
    p0->>p1: login
    p1->>p1: CheckCredentials
    p1->>p2: ByEmail
    p1->>p1: Check
    p1->>p2: ByUserID
    alt !uc.verifier.Verify(in.Password, u.Password)
        p1->>p1: RecordFailure
        p1->>p2: ByUserID
        p1->>p2: Save
        p1-)p3: AccountLocked
        p1-->>p0: Session
        Note over p0: flow ends here
    else otherwise
    end
    p1->>p1: RecordSuccess
    p1->>p2: ByUserID
    p1->>p2: Save
    p1->>p4: Assess → AssessResponse
    alt verdict == VerdictBlock
        p1->>p2: ByUserID
        p1->>p2: Save
        p1-)p3: SessionEnded
        p1-->>p0: Session
        Note over p0: flow ends here
    else otherwise
    end
    p1->>p2: Save
    p1-)p3: SessionStarted
    p1-->>p0: Session
