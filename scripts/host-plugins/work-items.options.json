{
  "type": "object",
  "additionalProperties": false,
  "required": ["trackers"],
  "properties": {
    "trackers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "provider", "baseUrl", "projects"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "provider": { "const": "youtrack" },
          "baseUrl": { "type": "string", "pattern": "^https?://" },
          "projects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
        }
      }
    },
    "repository": { "type": "string", "description": "Web URL of this Git checkout. Defaults to origin; never a credential URL." },
    "maxCommits": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 500, "description": "Maximum reachable commits inspected from HEAD. Truncation is reported." },
    "out": { "type": "string", "default": "work-items.json" }
  }
}
