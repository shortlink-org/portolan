{
  "name": "@shortlink-org/portolan",
  "description": "Generate a navigable architecture catalog from code and specifications.",
  "private": false,
  "version": "0.7.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/shortlink-org/portolan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shortlink-org/portolan.git"
  },
  "bugs": {
    "url": "https://github.com/shortlink-org/portolan/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "portolan": "cli/portolan.mjs"
  },
  "files": [
    "cli",
    "rules",
    "scripts",
    "src",
    "public",
    "schema",
    "go.mod",
    "go.sum",
    "catalog",
    "plugin",
    "internal/gohttp",
    "internal/gocall",
    "internal/goscan",
    "internal/wsdl",
    "plugins/*.wasm",
    "plugins/cmd/portolan-http-clients",
    "plugins/extract-http-clients",
    "plugins/openapi",
    "plugins/*/*.py",
    "plugins/*/*.ts",
    "plugins/*/*.json",
    "plugins/*/*.md",
    "plugins/*/*.toml",
    "plugins/*/*.lock",
    "plugins/*/src",
    "plugins/extract-java/build",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "portolan.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node cli/portolan.mjs dev",
    "build": "node cli/portolan.mjs build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:go": "GOFLAGS=-mod=mod go test ./...",
    "pretest:package": "npm run plugins:build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p plugins/extract-ts",
    "likec4:gen": "node scripts/gen-likec4.mjs && node scripts/likec4-bundle.mjs",
    "likec4:validate": "node scripts/likec4-bundle.mjs --validate",
    "predev": "npm run likec4:gen",
    "plugins:build": "GOFLAGS=-mod=mod GOOS=wasip1 GOARCH=wasm go build -trimpath -ldflags=\"-s -w\" -o plugins/portolan-go.wasm ./plugins/cmd/portolan-go && javac --release 21 -d plugins/extract-java/build plugins/extract-java/src/org/portolan/extract/*.java && dotnet build plugins/extract-csharp-ddd -c Release --nologo -v q",
    "schema": "npm run plugins:build && node scripts/schema.mjs",
    "schema:check": "npm run plugins:build && node scripts/schema.mjs --check",
    "gen": "npm run plugins:build && node scripts/gen.mjs",
    "gen:check": "npm run plugins:build && node scripts/gen.mjs --check",
    "diff": "node scripts/diff.mjs",
    "prepack": "npm run plugins:build"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1142.0",
    "@clack/prompts": "^1.8.1",
    "@marcbachmann/cel-js": "^8.0.0",
    "ajv": "^8.20.0",
    "oxc-parser": "^0.152.0",
    "oxc-resolver": "^11.24.2",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@ai-sdk/openai-compatible": "3.0.59",
    "@ai-sdk/react": "4.0.125",
    "@asyncapi/react-component": "^3.2.1",
    "@blocknote/core": "^0.55.0",
    "@blocknote/diagram-block": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@daypicker/react": "^10.0.1",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@scalar/api-reference-react": "^0.9.75",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "ai": "7.0.122",
    "cn": "0.4.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "likec4": "^1.59.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.0",
    "simple-icons": "^16.33.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
