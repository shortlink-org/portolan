{
  "name": "portolan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run likec4:gen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:go": "go test ./...",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p plugins/extract-ts",
    "likec4:gen": "node scripts/gen-likec4.mjs && likec4 gen react likec4 -o src/likec4/generated.jsx",
    "likec4:validate": "likec4 validate likec4",
    "predev": "npm run likec4:gen",
    "plugins:build": "GOOS=wasip1 GOARCH=wasm go build -o plugins/gen-markdown.wasm ./plugins/gen-markdown",
    "schema": "npm run plugins:build && node scripts/schema.mjs",
    "schema:check": "npm run plugins:build && node scripts/schema.mjs --check",
    "gen": "npm run plugins:build && node scripts/gen.mjs",
    "gen:check": "npm run plugins:build && node scripts/gen.mjs --check"
  },
  "dependencies": {
    "@asyncapi/react-component": "^3.1.8",
    "@headlessui/react": "^2.2.10",
    "@scalar/api-reference-react": "^0.9.66",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "likec4": "^1.59.2",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "oxc-parser": "^0.148.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.0"
  }
}
