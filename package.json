{
  "name": "portolan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run likec4:gen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "likec4:gen": "node scripts/gen-likec4.mjs && likec4 gen react likec4 -o src/likec4/generated.jsx",
    "likec4:validate": "likec4 validate likec4",
    "predev": "npm run likec4:gen"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "likec4": "^1.59.2",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
