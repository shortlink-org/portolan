node_modules
dist
*.local
.DS_Store

# Scratch catalog fragments for looking at a surface before the estate has any
# data for it. `*.local` does NOT match `foo.local.json`, and src/data.ts globs
# every json in these directories, so without this line one `git add .` commits
# example data nobody meant to publish.
data/*.local.json
examples/*/portolan/*.local.json

# LikeC4 react bundle: regenerated by `npm run likec4:gen`
src/likec4/generated.jsx
src/likec4/generated.d.ts

# Compiled generator plugins: rebuilt by `npm run plugins:build`
plugins/*.wasm

# The collector writes here while recording; the scrubbed copy beside it is
# what is committed.
examples/auth/telemetry/out/

# Binaries `go build` drops beside a plugin's main. The plugins run via `go run`
# or as wasm; a native binary is never the thing that is checked in.
plugins/*/extract-*
plugins/*/verify-*
plugins/*/fetch-*
plugins/gen-markdown/gen-markdown

# The Rust plugin builds into its own target directory
plugins/extract-rust/target

# The Java plugin compiles into a class directory beside its source
plugins/extract-java/build

# `go build ./plugins/...` drops the binary in the working directory; it is
# build output and was committed once by accident.
/extract-go
/extract-openapi
/extract-sql
/extract-proto
/extract-flows
/extract-asyncapi
/fetch-bsr
/fetch-git
/verify-otel
