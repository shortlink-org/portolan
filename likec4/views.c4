  dynamic view flow_oms_request_payment_on_order_placed {
    title 'Request payment on order placed'
    description 'The stored OrderPlaced triggers the RPC. Applying its answer also recovers a ledger save whose subsequent event publication failed.'
    bus -> shop.oms 'OrderPlaced' {
      color declared  line solid  head onormal
      notes 'examples/shop/oms/src/application/policy/request_payment_on_order_placed.rs:28'
    }
    shop.oms -> shop.oms 'RequestPayment' {
      color declared  line solid  head none
      notes 'examples/shop/oms/src/application/policy/request_payment_on_order_placed.rs:29'
    }
    shop.oms -> oms_pg 'by_id' {
      color declared  line solid  head none
      notes 'examples/shop/oms/src/application/order/usecases/request_payment/mod.rs:49'
    }
    shop.oms -> payments.ledger 'AuthorizeRequest → AuthorizeResponse' {
      color declared  line solid  head normal
      notes 'examples/shop/oms/src/application/order/usecases/request_payment/mod.rs:53'
    }
    alt {
      when 'self.request.handle(&event.order_id).await? is Some((Authorization::Authorized { payment_id }, amount))' {
        shop.oms -> shop.oms 'ConfirmOrder' {
          color declared  line solid  head none
          notes 'examples/shop/oms/src/application/policy/request_payment_on_order_placed.rs:31'
        }
        shop.oms -> oms_pg 'by_id' {
          color declared  line solid  head none
          notes 'examples/shop/oms/src/application/order/usecases/confirm_order/mod.rs:26'
        }
        shop.oms -> oms_pg 'save' {
          color declared  line solid  head none
          notes 'examples/shop/oms/src/application/order/usecases/confirm_order/mod.rs:38'
        }
        shop.oms -> bus 'OrderConfirmed' {
          color declared  line solid  head onormal
          notes 'examples/shop/oms/src/application/order/usecases/confirm_order/mod.rs:38'
        }
      }
      else 'self.request.handle(&event.order_id).await? is Some((Authorization::Declined(reason), _))' {
        shop.oms -> shop.oms 'CancelOrder' {
          color declared  line solid  head none
          notes 'examples/shop/oms/src/application/policy/request_payment_on_order_placed.rs:43'
        }
        shop.oms -> oms_pg 'by_id' {
          color declared  line solid  head none
          notes 'examples/shop/oms/src/application/order/usecases/cancel_order/mod.rs:35'
        }
        alt {
          when 'order.status is Status::Cancelled' {
            break 'ends the flow' {
            }
          }
          else 'otherwise' {
            shop.oms -> oms_pg 'save' {
              color declared  line solid  head none
              notes 'examples/shop/oms/src/application/order/usecases/cancel_order/mod.rs:50'
            }
            shop.oms -> bus 'OrderCancelled' {
              color declared  line solid  head onormal
              notes 'examples/shop/oms/src/application/order/usecases/cancel_order/mod.rs:50'
            }
          }
        }
      }
      else 'self.request.handle(&event.order_id).await? is None' {
      }
      else 'otherwise' {
      }
    }
  }

