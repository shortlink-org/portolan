  dynamic view flow_oms_confirm_order_on_payment_authorized {
    title 'Confirm order on payment authorized'
    description 'Confirms the order once the payment for it is authorised (ADR oms.0005). Declared ahead of its publisher: nothing in the estate says `payments.PaymentAuthorized` yet, and the catalog says so.'
    bus -> shop.oms 'PaymentAuthorized' {
      color unresolved  line dotted  head onormal
