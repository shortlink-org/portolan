    }
  }

  dynamic view flow_order_cancelled {
    title 'Order cancelled'
    description 'A customer cancels before the parcel moves, and two compensations run side by side: the money is unwound at the gateway, and the stop is taken off the route. Whether the money is voided or refunded depends on how far payment got, and the delivery half is declared everywhere and observed nowhere.'
    customer -> shop.oms 'CancelOrder' {
      color verified  line solid  head normal
      notes 'cancel_test.go:44'
    }
    shop.oms -> delivery.core 'GetShipment' {
      color declared  line dashed  head normal
      notes 'Cancelling is only allowed while the shipment is `held` or `planned`. The state comes from delivery, not from the order, so a stale read here is what lets a dispatched parcel be cancelled. — internal/oms/client/delivery.go:41'
    }
    alt {
      when 'shipment not yet dispatched' {
        shop.oms -> bus 'OrderCancelled' {
          color verified  line solid  head onormal
          notes 'cancel_test.go:61'
        }
        par 'compensations, which do not wait for each other' {
          bus -> payments.ledger 'OrderCancelled' {
            color verified  line solid  head onormal
            notes 'cancel_test.go:70'
          }
          alt {
            when 'authorization not yet captured' {
              payments.ledger -> psp_gateway 'Charges.Void' {
                color unresolved  line dotted  head normal
                notes 'Voiding costs nothing and leaves no trace on the customer\'s statement, which is why the capture is held back until dispatch in the first place. — internal/ledger/adapter/psp/client.go:171'
              }
              payments.ledger -> payments.ledger 'releaseHold' {
                color verified  line solid  head none
                notes 'cancel_test.go:83'
              }
            }
            else 'payment already captured' {
              payments.ledger -> psp_gateway 'Charges.Refund' {
                color unresolved  line dotted  head normal
                notes 'internal/ledger/adapter/psp/client.go:138'
              }
              payments.ledger -> bus 'RefundIssued' {
                color declared  line dashed  head onormal
                notes 'The same event the support refund publishes. Nothing in the payload says which of the two happened, so a consumer cannot tell a cancelled order from a returned one. — internal/ledger/app/refund.go:88'
              }
            }
          }
          bus -> delivery.core 'OrderCancelled' {
            color declared  line dashed  head onormal
            notes 'The subscription is registered in the delivery repo, but no test covers it and no trace in the sampled window shows it firing. — internal/delivery/app/subscribe.go:62'
          }
          delivery.core -> delivery.core 'removeStopAndReplan' {
            color declared  line dashed  head none
            notes 'internal/delivery/app/route.go:112'
          }
          delivery.core -> bus 'RoutePlanned' {
            color declared  line dashed  head onormal
            notes 'The route is republished without the stop. Consumers see a second RoutePlanned for the same route and are expected to take the later one. — internal/delivery/app/route.go:94'
          }
        }
        shop.oms -> customer 'cancellation confirmation' {
          color declared  line dashed  head normal
          notes 'internal/oms/notify/cancellation.go:19'
        }
      }
      else 'shipment already dispatched' {
        break 'ends the flow' {
          shop.oms -> customer '409 Conflict' {
            color verified  line solid  head normal
            notes 'The edge refuses and points the customer at returns instead. What happens from there is the refund-requested flow, and none of it is observed. — cancel_test.go:118'
          }
        }
      }
    }
  }

