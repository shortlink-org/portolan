  dynamic view flow_refund_requested {
    title 'Refund requested'
    description 'How a support-initiated refund is meant to travel: the window is read off the shipment, an undispatched parcel is recalled first, and the money is returned through the ledger. Written by hand from the design doc — not one step has been observed in a test or a trace, which is why every hop on this page is declared.'
    agent -> shop.oms 'RequestRefund' {
      color declared  line dashed  head normal
      notes 'The support console, not the storefront. The doc does not say what authorizes the agent or whether a partial amount is allowed. — refund-requested.md:24'
    }
    shop.oms -> delivery.core 'GetShipment' {
      color declared  line dashed  head normal
      notes 'The refund window runs from the delivery date on the shipment, not from the order date, so the shipment has to be read before anything is decided. — internal/oms/client/delivery.go:41'
    }
    shop.oms -> shop.oms 'checkRefundWindow' {
      color declared  line dashed  head none
      notes '30 days after delivery. Orders never delivered have no window at all — the doc leaves that case open. — internal/oms/app/refund.go:52'
    }
    alt {
      when 'shipment already delivered' {
        shop.oms -> shop.oms 'openReturnLabel' {
          color declared  line dashed  head none
          notes 'internal/oms/app/refund.go:71'
        }
      }
      else 'shipment still in transit' {
        shop.oms -> bus 'OrderCancelled' {
          color declared  line dashed  head onormal
          notes 'refund-requested.md:58'
        }
        bus -> delivery.core 'OrderCancelled' {
          color declared  line dashed  head onormal
          notes 'Delivery is expected to recall the parcel here. The handler is described in the design doc, but no subscription for OrderCancelled was found in the delivery repository. — refund-requested.md:61'
        }
      }
    }
    shop.oms -> payments.ledger 'Refund' {
      color declared  line dashed  head normal
      notes 'Both branches rejoin here. The doc does not say what the amount is when the parcel was recalled but the shipping was already billed. — internal/oms/client/payments.go:104'
    }
    payments.ledger -> payments.ledger 'openRefund' {
      color declared  line dashed  head none
      notes 'internal/ledger/app/refund.go:31'
    }
    loop 'polled hourly until the gateway leaves `pending`, up to 7 days' {
      payments.ledger -> payments.ledger 'pollGatewaySettlement' {
        color declared  line dashed  head none
        notes 'The doc says the gateway confirms by webhook and that the poll is only the fallback. Neither path is covered by a test, and nothing says what happens on day 8. — internal/ledger/app/refund.go:64'
      }
    }
    alt {
      when 'the gateway settles the refund' {
        payments.ledger -> bus 'RefundIssued' {
          color declared  line dashed  head onormal
          notes 'refund-requested.md:83'
        }
        par 'RefundIssued fan-out' {
          bus -> shop.oms 'RefundIssued' {
            color declared  line dashed  head onormal
            notes 'Moves the order to `refunded`. — refund-requested.md:88'
          }
          bus -> delivery.core 'RefundIssued' {
            color declared  line dashed  head onormal
            notes 'Closes the return leg. Same gap as the cancel handler above: declared in the doc, absent from the repository. — refund-requested.md:91'
          }
        }
        shop.oms -> agent 'refund receipt' {
          color declared  line dashed  head normal
          notes 'refund-requested.md:96'
        }
      }
      else 'the gateway refuses the refund' {
        break 'ends the flow' {
          payments.ledger -> payments.ledger 'recordRejection' {
            color declared  line dashed  head none
            notes 'The code and category are stored on the refund and nothing publishes them. Support finds out by looking, which the doc admits and does not fix. — refund-requested.md:101'
          }
        }
      }
    }
  }

  dynamic view flow_refund_requested_cross {
    title 'Refund requested — crossings only'
    agent -> shop.oms 'RequestRefund' {
      color declared  line dashed  head normal
      notes 'The support console, not the storefront. The doc does not say what authorizes the agent or whether a partial amount is allowed. — refund-requested.md:24'
    }
    shop.oms -> delivery.core 'GetShipment' {
      color declared  line dashed  head normal
      notes 'The refund window runs from the delivery date on the shipment, not from the order date, so the shipment has to be read before anything is decided. — internal/oms/client/delivery.go:41'
    }
    alt {
      when 'shipment still in transit' {
        shop.oms -> bus 'OrderCancelled' {
          color declared  line dashed  head onormal
          notes 'refund-requested.md:58'
        }
        bus -> delivery.core 'OrderCancelled' {
          color declared  line dashed  head onormal
          notes 'Delivery is expected to recall the parcel here. The handler is described in the design doc, but no subscription for OrderCancelled was found in the delivery repository. — refund-requested.md:61'
        }
      }
    }
    shop.oms -> payments.ledger 'Refund' {
      color declared  line dashed  head normal
      notes 'Both branches rejoin here. The doc does not say what the amount is when the parcel was recalled but the shipping was already billed. — internal/oms/client/payments.go:104'
    }
    alt {
      when 'the gateway settles the refund' {
        payments.ledger -> bus 'RefundIssued' {
          color declared  line dashed  head onormal
          notes 'refund-requested.md:83'
        }
        par 'RefundIssued fan-out' {
          bus -> shop.oms 'RefundIssued' {
            color declared  line dashed  head onormal
            notes 'Moves the order to `refunded`. — refund-requested.md:88'
          }
          bus -> delivery.core 'RefundIssued' {
            color declared  line dashed  head onormal
            notes 'Closes the return leg. Same gap as the cancel handler above: declared in the doc, absent from the repository. — refund-requested.md:91'
          }
        }
        shop.oms -> agent 'refund receipt' {
          color declared  line dashed  head normal
          notes 'refund-requested.md:96'
        }
      }
    }
  }

  dynamic view flow_shipment_tracking {
    title 'Shipment tracking'
    description 'Reconstructed from production traces over a 24 hour window: the tracking page, the carrier\'s scan webhook, and what each scan code sets off. Two things only the traces know about — a consumer no repository accounts for, and an exception path whose reader emits no spans at all.'
    customer -> delivery.core 'TrackShipment' {
      color verified  line solid  head normal
      notes 'Storefront tracking page. 41k calls in the window, p95 180 ms. — trace 9f2c1a../span 04'
    }
    delivery.core -> shop.oms 'GetOrder' {
      color verified  line solid  head normal
      notes 'Resolves the order reference shown beside the parcel. Present in 96% of the traces; the rest are served from the tracking cache. — trace 9f2c1a../span 06'
    }
    loop 'one iteration per carrier scan; 4 scans per shipment at p50 over the window' {
      carrier_api -> delivery.core 'POST /webhooks/carrier/scan' {
        color verified  line solid  head normal
        notes 'Signed with the carrier\'s shared secret. 1.3% of scans in the window are retries after a 5xx, and the traces show the retry landing on the same shipment without a second state change. — trace 7be40d../span 01'
      }
      delivery.core -> delivery.core 'RecordScan' {
        color verified  line solid  head none
        notes 'trace 7be40d../span 03'
      }
    }
    alt {
      when 'scan code DELIVERED' {
        delivery.core -> bus 'ShipmentDelivered' {
          color verified  line solid  head onormal
          notes 'trace 7be40d../span 27'
        }
        par 'ShipmentDelivered fan-out' {
          bus -> shop.oms 'ShipmentDelivered' {
            color verified  line solid  head onormal
            notes 'Closes the order and starts the 30-day refund window the refund flow reads. — trace 7be40d../span 29'
          }
          bus -> analytics_sink 'ShipmentDelivered' {
            color unresolved  line dotted  head onormal
            notes 'Seen in traces only, under client id `analytics-sink-2`. No subscription registration exists in any indexed repository, so the owning team is unknown and nobody can be told before this topic changes shape. — trace 7be40d../span 31'
          }
        }
      }
      else 'scan code EXCEPTION' {
        break 'ends the flow' {
          delivery.core -> delivery.core 'openDeliveryException' {
            color verified  line solid  head none
            notes 'The trace ends here. Whatever reads the exception queue emits no spans, so the catalog cannot say what happens to the parcel next. — trace 4c81f3../span 09'
          }
        }
      }
      else 'scan code IN_TRANSIT' {
        delivery.core -> delivery.core 'updateEta' {
          color verified  line solid  head none
          notes 'No event is published for an in-transit scan; the tracking page reads the shipment directly. 83% of the scans in the window end here. — trace 7be40d../span 12'
        }
      }
    }
  }

