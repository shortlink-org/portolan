  dynamic view flow_shipment_tracking {
    title 'Shipment tracking'
    description 'Reconstructed from production traces over a 24 hour window: the tracking page, the carrier\'s scan webhook, and what each scan code sets off. Two things only the traces know about — a consumer no repository accounts for, and an exception path whose reader emits no spans at all.'
    customer -> delivery.core 'TrackShipment' {
      color verified  line solid  head normal
      notes 'Storefront tracking page. 41k calls in the window, p95 180 ms. — trace 9f2c1a../span 04'
    }
    delivery.core -> shop.oms 'GetOrder' {
      color declared  line dashed  head normal
      notes 'Resolves the order reference shown beside the parcel. Present in 96% of the traces; the rest are served from the tracking cache. — trace 9f2c1a../span 06'
    }
    loop 'one iteration per carrier scan; 4 scans per shipment at p50 over the window' {
      carrier_api -> delivery.core 'POST /webhooks/carrier/scan' {
        color verified  line solid  head normal
        notes 'Signed with the carrier\'s shared secret. 1.3% of scans in the window are retries after a 5xx, and the traces show the retry landing on the same shipment without a second state change. — trace 7be40d../span 01'
      }
      delivery.core -> delivery.core 'RecordScan' {
        color verified  line solid  head none
        notes 'trace 7be40d../span 03'
      }
    }
    alt {
      when 'scan code DELIVERED' {
        delivery.core -> bus 'ShipmentDelivered' {
          color verified  line solid  head onormal
          notes 'trace 7be40d../span 27'
        }
        par 'ShipmentDelivered fan-out' {
          bus -> shop.oms 'ShipmentDelivered' {
            color declared  line dashed  head onormal
            notes 'Closes the order and starts the 30-day refund window the refund flow reads. — trace 7be40d../span 29'
          }
          bus -> analytics_sink 'ShipmentDelivered' {
            color unresolved  line dotted  head onormal
            notes 'Seen in traces only, under client id `analytics-sink-2`. No subscription registration exists in any indexed repository, so the owning team is unknown and nobody can be told before this topic changes shape. — trace 7be40d../span 31'
          }
        }
      }
      else 'scan code EXCEPTION' {
        break 'ends the flow' {
          delivery.core -> delivery.core 'openDeliveryException' {
            color verified  line solid  head none
            notes 'The trace ends here. Whatever reads the exception queue emits no spans, so the catalog cannot say what happens to the parcel next. — trace 4c81f3../span 09'
          }
        }
      }
      else 'scan code IN_TRANSIT' {
        delivery.core -> delivery.core 'updateEta' {
          color verified  line solid  head none
          notes 'No event is published for an in-transit scan; the tracking page reads the shipment directly. 83% of the scans in the window end here. — trace 7be40d../span 12'
        }
      }
    }
  }

