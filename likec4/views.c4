  dynamic view flow_gateway_webhook {
    title 'Gateway webhook'
    description 'The gateway\'s side of the story, arriving after the fact. One signed callback, four ways to read it: a replay to ignore, a capture to record, a charge with no local payment to adopt, and a failure to pass on. The adopt branch is the only repair for a checkout that timed out mid-authorization, and it is the one branch no test covers.'
    psp_gateway -> payments.ledger 'POST /webhooks/psp/v2' {
      color verified  line solid  head normal
      notes 'HMAC-signed body. The gateway retries for three days with backoff until it gets a 2xx, so every branch below has to tolerate being run twice. — webhook_test.go:38'
    }
    payments.ledger -> payments.ledger 'verifySignatureAndParse' {
      color verified  line solid  head none
      notes 'A bad signature is answered 401 and never reaches the dedup table. The test drives a tampered body for this. — internal/ledger/adapter/psp/webhook.go:44'
    }
    alt {
      when 'event id already applied' {
        payments.ledger -> payments.ledger 'dropDuplicate' {
          color verified  line solid  head none
          notes 'Dedup table keyed by the gateway\'s event id, rows kept 30 days. A replay older than that would be applied again; nothing guards it. — webhook_test.go:71'
        }
      }
      else 'charge.succeeded, matching a local authorization' {
        payments.ledger -> payments.ledger 'markCaptured' {
          color verified  line solid  head none
          notes 'internal/ledger/app/webhook.go:96'
        }
        payments.ledger -> bus 'PaymentCaptured' {
          color verified  line solid  head onormal
          notes 'webhook_test.go:104'
        }
      }
      else 'charge.succeeded, no local payment' {
        payments.ledger -> shop.oms 'GetOrder' {
          color verified  line solid  head normal
          notes 'The order reference travels in the gateway\'s metadata. The ledger reads the order back to decide whether the charge belongs to this estate at all. — internal/ledger/app/webhook.go:132'
        }
        payments.ledger -> payments.ledger 'adoptOrphanCharge' {
          color declared  line dashed  head none
          notes 'Closes the gap left when the synchronous Authorize in checkout timed out after the gateway had already charged. Read from the code; the integration suite has no fixture for it, and it is the only path that keeps a customer from being charged for an order the estate never opened. — internal/ledger/app/webhook.go:151'
        }
        payments.ledger -> bus 'PaymentAuthorized' {
          color declared  line dashed  head onormal
          notes 'Published late and out of order — consumers see the authorization after the charge already settled. — internal/ledger/app/webhook.go:168'
        }
      }
      else 'charge.failed' {
        payments.ledger -> bus 'PaymentDeclined' {
          color verified  line solid  head onormal
          notes 'webhook_test.go:126'
        }
        bus -> shop.oms 'PaymentDeclined' {
          color verified  line solid  head onormal
          notes 'webhook_test.go:131'
        }
      }
    }
    payments.ledger -> psp_gateway 'ack 200' {
      color verified  line solid  head normal
      notes 'Acked only after the branch above has committed. Anything else and the gateway replays, which is what makes the dedup table load-bearing. — webhook_test.go:142'
    }
  }

  dynamic view flow_gateway_webhook_cross {
