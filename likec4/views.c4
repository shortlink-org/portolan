  dynamic view flow_order_accepted {
    title 'Order accepted'
    description 'The narrow slice one integration test pins end to end: an order commits with its outbox row, the relay publishes it, the ledger picks it up and the authorization comes back. Every hop here is asserted, which is why this is the only flow with no gaps in it.'
    shop.oms -> oms_db 'insertOrderAndOutboxRow' {
      color verified  line solid  head none
      notes 'The order row and the OrderPlaced outbox row commit in one transaction, so the event cannot be published before the order exists or lost after it does. — internal/oms/adapter/postgres/order_repo.go:141'
    }
    shop.oms -> bus 'OrderPlaced' {
      color verified  line solid  head onormal
      notes 'Published by the outbox relay, not by the request handler. The test waits on the relay rather than on PlaceOrder returning. — order_accepted_test.go:58'
    }
    bus -> payments.ledger 'OrderPlaced' {
      color verified  line solid  head onormal
      notes 'Consumer group `ledger-orders`, at-least-once. The test replays the same message a second time and asserts nothing changes. — order_accepted_test.go:71'
    }
    payments.ledger -> payments.ledger 'openReconciliationRecord' {
      color verified  line solid  head none
      notes 'The event only opens the record the gateway webhook later matches against. Authorizing is the synchronous call below, because checkout needs the answer before it can confirm. — internal/ledger/app/intent.go:47'
    }
    shop.oms -> payments.ledger 'Authorize' {
      color verified  line solid  head normal
      notes 'Carries the order\'s idempotency key. The gateway behind the ledger is the sandbox stub here; the real hop out of the estate is drawn in the checkout flow. — order_accepted_test.go:88'
    }
    payments.ledger -> bus 'PaymentAuthorized' {
      color verified  line solid  head onormal
      notes 'order_accepted_test.go:103'
    }
    bus -> shop.oms 'PaymentAuthorized' {
      color verified  line solid  head onormal
      notes 'order_accepted_test.go:114'
    }
  }

