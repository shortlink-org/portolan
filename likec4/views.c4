  dynamic view flow_auth_change_password {
    title 'Change password'
    description 'Replaces the password of a user, given the current one. Source-backed cross-protocol continuations are included.'
    client -> auth.auth 'ChangePasswordRequest' {
      color declared  line solid  head normal
      notes 'examples/auth/internal/user/infrastructure/http/change_password.go:20'
    }
    auth.auth -> auth_pg 'ByToken' {
      color declared  line solid  head none
      notes 'examples/auth/internal/session/application/validate/usecase.go:33'
    }
    auth.auth -> auth_pg 'ByID' {
      color declared  line solid  head none
      notes 'examples/auth/internal/user/application/change_password/usecase.go:32'
    }
    auth.auth -> auth_pg 'Save' {
      color declared  line solid  head none
      notes 'examples/auth/internal/user/application/change_password/usecase.go:48'
    }
    auth.auth -> bus 'PasswordChanged' {
      color declared  line solid  head onormal
      notes 'examples/auth/internal/user/application/change_password/usecase.go:48'
    }
    auth.auth -> client '204' {
      color declared  line dashed  head normal
      notes 'Synthesized from the proven synchronous HTTP handler return.'
    }
  }

