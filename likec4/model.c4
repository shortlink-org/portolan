  payments.ledger -> psp_gateway 'Void' {
    style { color unresolved  line dotted  head normal }
  }
  delivery.core -> analytics_sink 'ShipmentDispatched' {
    style { color declared  line dashed  head onormal }
  }
  delivery.core -> analytics_sink 'ShipmentDelivered' {
    style { color unresolved  line dotted  head onormal }
  }
  delivery.core -> shop.oms 'ShipmentDelivered' {
    style { color declared  line dashed  head onormal }
  }
  delivery.core -> shop.oms 'GetOrder' {
    style { color verified  line solid  head normal }
  }
  delivery.core -> payments.ledger 'GetPayment' {
    style { color declared  line dashed  head normal }
  }
  payments.ledger.payment -> payments.ledger.pg 'journal_entries' {
    style { color declared  line dashed  head normal }
  }
  payments.ledger.refund -> payments.ledger.pg 'refunds' {
    style { color declared  line dashed  head normal }
  }
  delivery.core.shipment -> delivery.core.pg 'packages, parcels' {
