// GENERATED — do not edit.
model {
  customer = actor 'customer'
  oms_db = store 'oms-db (postgres)'
  fraud_scoring = unknown 'fraud-scoring (unknown)'
  bus = broker 'bus'
  psp_gateway = external 'psp-gateway (external)'
  pricing_db = store 'pricing-db (postgres)'
  agent = actor 'support agent'
  carrier_api = external 'carrier-api (external)'
  analytics_sink = unknown 'analytics-sink (unknown)'
  client = actor 'client'
  auth_pg = store 'auth-pg'
  risk_v1 = unknown 'risk.v1'
  billing_pg = store 'billing-pg'
  cart_pg = store 'cart-pg'

  shop = context 'Shop' {
    description 'Everything the customer touches before money moves: baskets, orders and prices.'
    style { color ctx0 }
    oms = service 'Order Management' {
      description 'github.com/acme/shop/services/oms'
      style { color ctx0 }
      _order = aggregate 'Order' {
        OrderPlaced = event 'OrderPlaced' {
          description 'Adds the acquisition channel so pricing and delivery can differ per channel.'
        }
        OrderConfirmed = event 'OrderConfirmed' {
          description 'Payment captured and the order is committed to fulfilment.'
        }
        OrderCancelled = event 'OrderCancelled' {
          description 'The order was cancelled before fulfilment, by the customer or by risk.'
        }
      }
      pg = store 'Order management database' {
        description 'postgres'
      }
    }
    pricing = service 'Pricing' {
      description 'github.com/acme/shop/services/pricing'
      style { color ctx0 }
      quote = aggregate 'Quote' {
        QuoteIssued = event 'QuoteIssued' {
          description 'A priced, time-boxed answer for one basket and one customer.'
        }
        QuoteExpired = event 'QuoteExpired' {
          description 'A quote passed its expiry without being consumed.'
        }
      }
      price_list = aggregate 'PriceList' {
      }
      cache = store 'Price list cache' {
        description 'redis'
      }
    }
    billing = service 'Billing' {
      description 'github.com/shortlink-org/portolan/examples/shop/billing'
      style { color ctx0 }
      invoice = aggregate 'Invoice' {
        InvoiceIssued = event 'InvoiceIssued' {
          description 'The invoice is final and the customer has been asked to pay it.'
        }
        InvoicePaid = event 'InvoicePaid' {
          description 'The money arrived and the invoice is closed. Nothing is owed on the order.'
        }
        InvoiceVoided = event 'InvoiceVoided' {
          description 'The invoice was ended without payment, and nobody will be asked again.'
        }
      }
      pg = store 'Billing database' {
        description 'postgres'
      }
    }
    cart = service 'Shopping Cart' {
      description 'github.com/shortlink-org/portolan/examples/shop/cart'
      style { color ctx0 }
      basket = aggregate 'Basket' {
        BasketAbandoned = event 'BasketAbandoned' {
          description 'Nobody touched the basket for a day, and the sweep said so (cart.0006).'
        }
        BasketCheckedOut = event 'BasketCheckedOut' {
          description 'The basket is frozen. This is the handoff: whoever places the order listens
for it, and pricing expires the quote it issued.'
        }
        BasketCreated = event 'BasketCreated' {
          description 'A basket exists, for a visitor or for a customer.'
        }
        BasketItemAdded = event 'BasketItemAdded' {
          description 'A line went in, or grew; `quantity` is the line\'s after the add.'
        }
        BasketItemRemoved = event 'BasketItemRemoved' {
          description 'A line went out.'
        }
        BasketMerged = event 'BasketMerged' {
          description 'The visitor\'s basket has given its lines to the customer\'s and is done
(cart.0005). `basketId` is the one that emptied; `intoBasketId` the one
that now holds everything.'
        }
      }
      pg = store 'Cart database' {
        description 'postgres'
      }
    }
  }
  payments = context 'Payments' {
    description 'A double-entry ledger and the PSP integrations that feed it. Nothing here knows what an order is for.'
    style { color ctx1 }
    ledger = service 'Ledger' {
      description 'github.com/acme/payments/services/ledger'
      style { color ctx1 }
      payment = aggregate 'Payment' {
        PaymentAuthorized = event 'PaymentAuthorized' {
          description 'Funds reserved with the PSP. No money has moved yet.'
        }
        PaymentCaptured = event 'PaymentCaptured' {
          description 'Reserved funds settled. This is the event fulfilment reacts to.'
        }
        PaymentDeclined = event 'PaymentDeclined' {
          description 'The PSP refused the authorisation or the capture.'
        }
      }
      refund = aggregate 'Refund' {
        RefundIssued = event 'RefundIssued' {
          description 'A compensating posting pair against a captured payment.'
        }
      }
      pg = store 'Ledger database' {
        description 'postgres'
      }
    }
  }
  delivery = context 'Delivery' {
    description 'Routes, parcels and proof of delivery. Reacts to captured payments, never to placed orders.'
    style { color ctx2 }
    core = service 'Delivery Core' {
      description 'github.com/acme/delivery/services/core'
      style { color ctx2 }
      shipment = aggregate 'Shipment' {
        ShipmentDispatched = event 'ShipmentDispatched' {
          description 'A parcel physically left the depot.'
        }
        ShipmentDelivered = event 'ShipmentDelivered' {
          description 'Proof of delivery recorded. Terminal for the shipment.'
        }
      }
      route = aggregate 'Route' {
        RoutePlanned = event 'RoutePlanned' {
          description 'A vehicle and window were assigned a stop sequence.'
        }
      }
      pg = store 'Delivery database' {
        description 'postgres'
      }
    }
  }
  auth = context 'Authentication' {
    description 'Who someone is, and whether they are still logged in. The only service in the estate that stores credentials, and the only one allowed to mint or revoke a session.'
    style { color ctx3 }
    auth = service 'Authentication & Sessions' {
      description 'github.com/shortlink-org/portolan/examples/auth'
      style { color ctx3 }
      lockout = aggregate 'Lockout' {
        AccountLocked = event 'AccountLocked' {
          description 'AccountLocked is published when an account starts refusing logins because of too many wrong passwords in a row. Until says when it stops.'
        }
      }
      session = aggregate 'Session' {
        SessionEnded = event 'SessionEnded' {
          description 'SessionEnded is published when a session is deliberately ended.'
        }
        SessionStarted = event 'SessionStarted' {
          description 'SessionStarted is published on a successful login. ExpiresAt is on the event so a consumer can reason about the session\'s lifetime without asking auth again on every check.'
        }
      }
      user = aggregate 'User' {
        PasswordChanged = event 'PasswordChanged' {
          description 'PasswordChanged is published when a user\'s password is replaced. It says the password is different now; it does not carry the password, old or new, in any form.'
        }
        UserRegistered = event 'UserRegistered' {
          description 'UserRegistered is published once per user, at registration. It carries the address because consumers routinely need to reach the person, and asking auth for it on every event would make the bus useless.'
        }
      }
      pg = store 'Auth database' {
        description 'postgres'
      }
    }
  }

