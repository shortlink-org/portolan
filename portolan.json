{
  "$schema": "./schema/portolan.schema.json",
  "$comment": "Where the facts come from, what produces them, and what turns them into something to read.",
  "sources": [
    "data/*.json",
    "examples/*/portolan/*.json",
    "examples/*/*/portolan/*.json"
  ],
  "plugins": [
    {
      "name": "go-domain",
      "process": {
        "cmd": "go run ./plugins/extract-go"
      }
    },
    {
      "name": "ts-domain",
      "process": {
        "cmd": "node plugins/extract-ts/main.ts"
      }
    },
    {
      "name": "rust-domain",
      "process": {
        "cmd": "cargo run --quiet --manifest-path plugins/extract-rust/Cargo.toml"
      }
    },
    {
      "name": "java-domain",
      "process": {
        "cmd": "java -cp plugins/extract-java/build org.portolan.extract.Main"
      }
    },
    {
      "name": "django-domain",
      "process": {
        "cmd": "python3 plugins/extract-django/main.py"
      }
    },
    {
      "name": "openapi",
      "process": {
        "cmd": "go run ./plugins/extract-openapi"
      }
    },
    {
      "name": "asyncapi",
      "process": {
        "cmd": "go run ./plugins/extract-asyncapi"
      }
    },
    {
      "name": "sql",
      "process": {
        "cmd": "go run ./plugins/extract-sql"
      }
    },
    {
      "name": "markdown",
      "wasm": {
        "url": "file://plugins/gen-markdown.wasm"
      }
    },
    {
      "name": "otel",
      "process": {
        "cmd": "go run ./plugins/verify-otel"
      }
    },
    {
      "name": "flows",
      "process": {
        "cmd": "go run ./plugins/extract-flows"
      }
    },
    {
      "name": "bsr",
      "process": {
        "cmd": "go run ./plugins/fetch-bsr"
      }
    },
    {
      "name": "proto",
      "process": {
        "cmd": "go run ./plugins/extract-proto"
      }
    }
  ],
  "extract": [
    {
      "plugin": "flows",
      "in": "data/flows",
      "out": "data",
      "options": {
        "out": "flows.json"
      }
    },
    {
      "plugin": "go-domain",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "contextName": "Authentication",
        "contextSummary": "Who someone is, and whether they are still logged in. The only service in the estate that stores credentials, and the only one allowed to mint or revoke a session.",
        "classification": "core",
        "service": "auth",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "out": "domain.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "service": "auth",
        "spec": "internal/infrastructure/transport/http/gen/openapi.yaml",
        "out": "api.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "service": "auth",
        "store": "pg",
        "name": "Auth database",
        "out": "stores.json"
      }
    },
    {
      "plugin": "ts-domain",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "peers": {
          "auth.v1": "auth.auth",
          "shop.v1": "shop.pricing"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "spec": "src/infrastructure/transport/http/gen/openapi.yaml",
        "out": "api.json"
      }
    },
    {
      "plugin": "asyncapi",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "spec": "src/infrastructure/transport/bus/asyncapi.yaml",
        "out": "bus.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "store": "pg",
        "name": "Cart database",
        "repositories": "src/infrastructure/repository",
        "out": "stores.json"
      }
    },
    {
      "plugin": "django-domain",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "store": "pg",
        "storeName": "Billing database",
        "peers": {
          "auth.v1": "auth.auth"
        },
        "events": {
          "shop_events.payments": "payments.ledger.payment"
        },
        "out": "domain.json",
        "storesOut": "stores.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "spec": "invoices/schema/openapi.yaml",
        "out": "api.json"
      }
    },
    {
      "plugin": "asyncapi",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "spec": "invoices/bus/asyncapi.yaml",
        "out": "bus.json"
      }
    },
    {
      "plugin": "go-domain",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "peers": {
          "shop.v1": "shop.oms"
        },
        "events": {
          "github.com/shortlink-org/portolan/examples/shop/pricing/internal/infrastructure/cart": "shop.cart.basket"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "proto",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "paths": [
          "internal/infrastructure/transport/grpc/quote/proto",
          "internal/infrastructure/transport/grpc/price_list/proto"
        ],
        "modules": {
          "internal/infrastructure/transport/grpc/quote/proto": "local:shop/quote",
          "internal/infrastructure/transport/grpc/price_list/proto": "local:shop/price-list"
        },
        "out": "proto.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "store": "pg",
        "name": "Pricing database",
        "out": "stores.json"
      }
    },
    {
      "plugin": "java-domain",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "context": "payments",
        "contextName": "Payments",
        "contextSummary": "Money, and the record of every movement of it. Nothing here decides whether to charge - it is asked, and it writes down what happened either way.",
        "classification": "core",
        "service": "ledger",
        "store": "pg",
        "peers": {
          "shop.v1": "shop.oms"
        },
        "events": {
          "org.portolan.payments.ledger.infrastructure.oms.event": "shop.oms.order"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "proto",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "context": "payments",
        "service": "ledger",
        "paths": [
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/payment/proto",
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/refund/proto"
        ],
        "modules": {
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/payment/proto": "local:payments/payment",
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/refund/proto": "local:payments/refund"
        },
        "out": "proto.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "context": "payments",
        "service": "ledger",
        "store": "pg",
        "name": "Ledger database",
        "repositories": "src/main/java/org/portolan/payments/ledger/infrastructure/repository",
        "out": "stores.json"
      }
    },
    {
      "plugin": "bsr",
      "in": "examples/shop/oms",
      "out": "examples/shop/oms/vendor/proto",
      "options": {
        "cache": "examples/shop/oms/vendor/proto",
        "modules": [
          {
            "module": "buf.build/shortlink-org/portolan-shop-order",
            "commit": "6ae5e6ade8a547a59553b3aae02a2335"
          }
        ]
      }
    },
    {
      "plugin": "proto",
      "in": "examples/shop/oms",
      "out": "examples/shop/oms/portolan",
      "options": {
        "context": "shop",
        "service": "oms",
        "paths": [
          "vendor/proto/shortlink-org/portolan-shop-order"
        ],
        "out": "proto.json"
      }
    },
    {
      "plugin": "rust-domain",
      "in": "examples/shop/oms",
      "out": "examples/shop/oms/portolan",
      "options": {
        "context": "shop",
        "service": "oms",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "peers": {
          "payments.v1": "payments.ledger"
        },
        "events": {
          "crate::infrastructure::cart": "shop.cart.basket",
          "crate::infrastructure::ledger": "payments.ledger.payment"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/shop/oms",
      "out": "examples/shop/oms/portolan",
      "options": {
        "context": "shop",
        "service": "oms",
        "store": "pg",
        "name": "Order database",
        "repositories": "src/infrastructure/repository",
        "out": "stores.json"
      }
    }
  ],
  "verify": [
    {
      "plugin": "otel",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "traces": [
          "telemetry/traces.jsonl"
        ],
        "out": "observed.json"
      }
    },
    {
      "plugin": "otel",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "traces": [
          "telemetry/traces.jsonl"
        ],
        "out": "observed.json"
      }
    },
    {
      "plugin": "otel",
      "in": "examples/shop/oms",
      "out": "examples/shop/oms/portolan",
      "options": {
        "traces": [
          "telemetry/traces.jsonl"
        ],
        "out": "observed.json"
      }
    }
  ],
  "generate": [
    {
      "plugin": "markdown",
      "out": "docs",
      "options": {
        "title": "Example estate"
      }
    }
  ]
}
