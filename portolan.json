{
  "$schema": "./schema/portolan.schema.json",
  "$comment": "Where the facts come from, what produces them, and what turns them into something to read.",
  "defaultCatalog": "portolan",
  "catalogs": [
    {
      "id": "portolan",
      "title": "Portolan",
      "sources": ["portolan/*.json"],
      "contexts": ["portolan"],
      "projects": ["portolan"]
    },
    {
      "id": "example",
      "title": "Example estate",
      "sources": [
        "data/*.json",
        "examples/*/portolan/*.json",
        "examples/*/*/portolan/*.json",
        "examples/*/*/*/portolan/*.json",
        "vendor/repos/*/*/git.repo.json",
        "vendor/repos/**/portolan/*.json",
        "examples/argocd/argocd.apps.json"
      ],
      "contexts": ["auth", "shop", "delivery", "payments", "storefront"],
      "projects": ["auth", "shop-cart", "shop-billing", "shop-pricing", "delivery-core", "payments-ledger", "shop-oms"]
    },
    {
      "id": "bagisto",
      "title": "Bagisto",
      "sources": ["vendor/repos/bagisto/bagisto/git.repo.json", "vendor/repos/bagisto/bagisto/catalog/*.json"],
      "contexts": ["commerce"],
      "projects": []
    }
  ],
  "projects": [
    {
      "id": "auth",
      "name": "Authentication",
      "root": "examples/auth",
      "context": "auth",
      "service": "auth"
    },
    {
      "id": "shop-cart",
      "name": "Shop / Cart",
      "root": "examples/shop/cart",
      "context": "shop",
      "service": "cart"
    },
    {
      "id": "shop-billing",
      "name": "Shop / Billing",
      "root": "examples/shop/billing",
      "context": "shop",
      "service": "billing"
    },
    {
      "id": "shop-pricing",
      "name": "Shop / Pricing",
      "root": "examples/shop/pricing",
      "context": "shop",
      "service": "pricing"
    },
    {
      "id": "delivery-core",
      "name": "Delivery / Core",
      "root": "examples/shop/delivery/core",
      "context": "delivery",
      "service": "core"
    },
    {
      "id": "payments-ledger",
      "name": "Payments / Ledger",
      "root": "examples/payments/ledger",
      "context": "payments",
      "service": "ledger"
    },
    {
      "id": "shop-oms",
      "name": "Shop / OMS",
      "root": "examples/shop/oms",
      "context": "shop",
      "service": "oms"
    },
    {
      "id": "portolan",
      "name": "Portolan",
      "root": ".",
      "context": "portolan",
      "service": "portolan"
    }
  ],
  "sources": [
    "data/*.json",
    "portolan/*.json",
    "examples/*/portolan/*.json",
    "examples/*/*/portolan/*.json",
    "examples/*/*/*/portolan/*.json",
    "vendor/repos/*/*/git.repo.json",
    "vendor/repos/**/portolan/*.json",
    "examples/argocd/argocd.apps.json"
  ],
  "plugins": [
    {
      "name": "project",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "commands",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "go-domain",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "ts-domain",
      "process": {
        "command": "node",
        "args": ["plugins/extract-ts/main.ts"]
      }
    },
    {
      "name": "rust-domain",
      "process": {
        "command": "cargo",
        "args": ["run", "--quiet", "--manifest-path", "plugins/extract-rust/Cargo.toml"]
      }
    },
    {
      "name": "laravel-domain",
      "process": {
        "command": "cargo",
        "args": ["run", "--quiet", "--manifest-path", "plugins/extract-laravel/Cargo.toml"]
      }
    },
    {
      "name": "java-domain",
      "process": {
        "command": "java",
        "args": ["-cp", "plugins/extract-java/build", "org.portolan.extract.Main"]
      }
    },
    {
      "name": "django-domain",
      "process": {
        "command": "python3",
        "args": ["plugins/extract-django/main.py"]
      }
    },
    {
      "name": "celery",
      "process": {
        "command": "python3",
        "args": ["plugins/extract-celery/main.py"]
      }
    },
    {
      "name": "python-kafka",
      "process": {
        "command": "python3",
        "args": ["plugins/extract-python-kafka/main.py"]
      }
    },
    {
      "name": "openapi",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "wsdl",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "http-clients",
      "process": {
        "command": "go",
        "args": ["run", "-mod=mod", "./plugins/cmd/portolan-http-clients"]
      }
    },
    {
      "name": "redis",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "river",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "watermill",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "go-nats",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "go-sqs",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "terraform",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "k8s",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "asyncapi",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "graphql",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "sql",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "markdown",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "mermaid",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "backstage",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "otel",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "codeowners",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "adr",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "glossary",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "flows",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "bsr",
      "host": "fetch-bsr"
    },
    {
      "name": "git",
      "host": "fetch-git"
    },
    {
      "name": "csr",
      "host": "fetch-csr"
    },
    {
      "name": "k8s-cluster",
      "host": "fetch-k8s"
    },
    {
      "name": "argocd",
      "host": "fetch-argocd"
    },
    {
      "name": "csr-schemas",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    },
    {
      "name": "proto",
      "wasm": {
        "url": "file://plugins/portolan-go.wasm"
      }
    }
  ],
  "extract": [
    {
      "plugin": "adr",
      "in": "data/adr",
      "out": "data",
      "options": {
        "files": [
          "*.md"
        ],
        "out": "adr.json"
      }
    },
    {
      "plugin": "project",
      "in": "scripts",
      "out": "portolan",
      "options": {
        "group": "portolan",
        "groupName": "Portolan",
        "groupSummary": "The tool that reads an architecture catalog from the code and specifications that already describe a software estate. It is documented here as the system that extracts, merges, validates and presents those facts.",
        "component": "host",
        "componentName": "Host",
        "componentKind": "cli",
        "technologies": ["Node.js"],
        "repo": "github.com/shortlink-org/portolan",
        "out": "host.json"
      }
    },
    {
      "plugin": "project",
      "in": "src",
      "out": "portolan",
      "options": {
        "group": "portolan",
        "component": "site",
        "componentName": "Site",
        "componentKind": "webapp",
        "technologies": ["TypeScript", "React", "Vite"],
        "repo": "github.com/shortlink-org/portolan",
        "out": "site.json"
      }
    },
    {
      "plugin": "project",
      "in": "plugins",
      "out": "portolan",
      "options": {
        "group": "portolan",
        "component": "plugins",
        "componentName": "Plugins",
        "componentKind": "cli",
        "technologies": ["Go", "TypeScript", "Rust", "Java", "Python"],
        "repo": "github.com/shortlink-org/portolan",
        "out": "plugins.json"
      }
    },
    {
      "plugin": "commands",
      "in": ".",
      "out": "portolan",
      "options": {
        "context": "portolan",
        "service": "host",
        "out": "commands.json"
      }
    },
    {
      "plugin": "flows",
      "in": "flows",
      "out": "portolan",
      "options": {
        "out": "flows.json"
      }
    },
    {
      "plugin": "adr",
      "in": "adr",
      "out": "portolan",
      "options": {
        "files": ["*.md"],
        "scope": "portolan",
        "out": "adr.json"
      }
    },
    {
      "plugin": "glossary",
      "in": ".",
      "out": "portolan",
      "options": {
        "context": "portolan",
        "out": "glossary.json"
      }
    },
    {
      "plugin": "go-domain",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "contextName": "Authentication",
        "contextSummary": "Who someone is, and whether they are still logged in. The only service in the estate that stores credentials, and the only one allowed to mint or revoke a session.",
        "classification": "generic",
        "service": "auth",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "out": "domain.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "service": "auth",
        "spec": "internal/transport/http/gen/openapi.yaml",
        "out": "api.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "service": "auth",
        "store": "pg",
        "name": "Auth database",
        "out": "stores.json"
      }
    },
    {
      "plugin": "adr",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "out": "adr.json"
      }
    },
    {
      "plugin": "glossary",
      "in": "examples/auth",
      "out": "examples/auth/portolan",
      "options": {
        "context": "auth",
        "out": "glossary.json"
      }
    },
    {
      "plugin": "commands",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "out": "commands.json"
      }
    },
    {
      "plugin": "k8s",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "paths": ["deploy/k8s"],
        "out": "k8s.json"
      }
    },
    {
      "plugin": "ts-domain",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "contextName": "Shop",
        "contextSummary": "What a customer is buying, what it costs and what they owe for it: the basket while it is still changing, the price it was promised at, the order it became, and the invoice for it. It moves no money and delivers nothing.",
        "classification": "core",
        "service": "cart",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "peers": {
          "auth.v1": "auth.auth",
          "shop.v1": "shop.pricing"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "spec": "src/infrastructure/transport/http/gen/openapi.yaml",
        "out": "api.json"
      }
    },
    {
      "plugin": "asyncapi",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "spec": "src/infrastructure/transport/bus/asyncapi.yaml",
        "out": "bus.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "context": "shop",
        "service": "cart",
        "store": "pg",
        "name": "Cart database",
        "repositories": "src/infrastructure/repository",
        "out": "stores.json"
      }
    },
    {
      "plugin": "adr",
      "in": "examples/shop/cart",
      "out": "examples/shop/cart/portolan",
      "options": {
        "out": "adr.json"
      }
    },
    {
      "plugin": "django-domain",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "store": "pg",
        "storeName": "Billing database",
        "peers": {
          "auth.v1": "auth.auth"
        },
        "events": {
          "shop_events.payments": "payments.ledger.payment"
        },
        "out": "domain.json",
        "storesOut": "stores.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "spec": "invoices/schema/openapi.yaml",
        "out": "api.json"
      }
    },
    {
      "plugin": "asyncapi",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "spec": "invoices/bus/asyncapi.yaml",
        "out": "bus.json"
      }
    },
    {
      "plugin": "celery",
      "in": "examples/shop/billing",
      "out": "examples/shop/billing/portolan",
      "options": {
        "context": "shop",
        "service": "billing",
        "out": "celery.json"
      }
    },
    {
      "plugin": "go-domain",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "peers": {
          "shop.v1": "shop.oms"
        },
        "events": {
          "github.com/shortlink-org/portolan/examples/shop/pricing/internal/infrastructure/cart": "shop.cart.basket"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "proto",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "paths": [
          "internal/infrastructure/transport/grpc/quote/proto",
          "internal/infrastructure/transport/grpc/price_list/proto"
        ],
        "modules": {
          "internal/infrastructure/transport/grpc/quote/proto": "buf.build/shortlink-org/portolan-shop-quote",
          "internal/infrastructure/transport/grpc/price_list/proto": "buf.build/shortlink-org/portolan-shop-price-list"
        },
        "out": "proto.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "store": "pg",
        "name": "Pricing database",
        "out": "stores.json"
      }
    },
    {
      "plugin": "commands",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "out": "commands.json"
      }
    },
    {
      "plugin": "k8s",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "paths": ["deploy/k8s"],
        "out": "k8s.json"
      }
    },
    {
      "plugin": "go-nats",
      "in": "examples/shop/pricing",
      "out": "examples/shop/pricing/portolan",
      "options": {
        "context": "shop",
        "service": "pricing",
        "out": "nats.json"
      }
    },
    {
      "plugin": "commands",
      "in": "examples/shop/delivery/core",
      "out": "examples/shop/delivery/core/portolan",
      "options": {
        "context": "delivery",
        "service": "core",
        "out": "commands.json"
      }
    },
    {
      "plugin": "ts-domain",
      "in": "examples/shop/delivery/core",
      "out": "examples/shop/delivery/core/portolan",
      "options": {
        "context": "delivery",
        "contextName": "Delivery",
        "contextSummary": "Parcels, vans and the day they are driven. Told what to carry and asked where it got to; it decides neither.",
        "classification": "supporting",
        "service": "core",
        "serviceName": "Delivery Core",
        "repo": "github.com/shortlink-org/portolan",
        "store": "pg",
        "peers": {
          "shop.v1": "shop.oms"
        },
        "events": {
          "../ledger/events.ts": "payments.ledger.payment"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "proto",
      "in": "examples/shop/delivery/core",
      "out": "examples/shop/delivery/core/portolan",
      "options": {
        "context": "delivery",
        "service": "core",
        "paths": [
          "src/infrastructure/transport/grpc/shipment/proto",
          "src/infrastructure/transport/grpc/route/proto"
        ],
        "modules": {
          "src/infrastructure/transport/grpc/shipment/proto": "buf.build/shortlink-org/portolan-delivery-shipment",
          "src/infrastructure/transport/grpc/route/proto": "buf.build/shortlink-org/portolan-delivery-route"
        },
        "out": "proto.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/shop/delivery/core",
      "out": "examples/shop/delivery/core/portolan",
      "options": {
        "context": "delivery",
        "service": "core",
        "store": "pg",
        "name": "Delivery database",
        "repositories": "src/infrastructure/repository",
        "out": "stores.json"
      }
    },
    {
      "plugin": "adr",
      "in": "examples/shop/delivery/core",
      "out": "examples/shop/delivery/core/portolan",
      "options": {
        "out": "adr.json"
      }
    },
    {
      "plugin": "glossary",
      "in": "examples/shop/delivery/core",
      "out": "examples/shop/delivery/core/portolan",
      "options": {
        "context": "delivery",
        "out": "glossary.json"
      }
    },
    {
      "plugin": "commands",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "context": "payments",
        "service": "ledger",
        "out": "commands.json"
      }
    },
    {
      "plugin": "java-domain",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "context": "payments",
        "contextName": "Payments",
        "contextSummary": "Money, and the record of every movement of it. Nothing here decides whether to charge - it is asked, and it writes down what happened either way.",
        "classification": "supporting",
        "service": "ledger",
        "store": "pg",
        "peers": {
          "shop.v1": "shop.oms"
        },
        "externals": {
          "stripe.v1": "stripe"
        },
        "events": {
          "org.portolan.payments.ledger.application.oms": "shop.oms.order"
        },
        "out": "domain.json"
      }
    },
    {
      "plugin": "openapi",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "external": "stripe",
        "externalName": "Stripe",
        "externalSummary": "The card network the ledger moves money through. Nobody in the estate provides it; the copy of its document beside the ledger's adapter is narrowed to the four operations the ledger calls, and is all the catalog claims about it.",
        "externalUrl": "https://docs.stripe.com/api",
        "spec": "src/main/java/org/portolan/payments/ledger/infrastructure/stripe/openapi/openapi.yaml",
        "out": "stripe.json"
      }
    },
    {
      "plugin": "proto",
      "in": "examples/payments/ledger",
      "out": "examples/payments/ledger/portolan",
      "options": {
        "context": "payments",
        "service": "ledger",
        "paths": [
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/payment/proto",
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/refund/proto"
        ],
        "modules": {
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/payment/proto": "buf.build/shortlink-org/portolan-payments-payment",
          "src/main/java/org/portolan/payments/ledger/infrastructure/transport/grpc/refund/proto": "buf.build/shortlink-org/portolan-payments-refund"
        },
        "out": "proto.json"
      }
    },
    {
      "plugin": "sql",
      "in": "examples/payments/ledger",
