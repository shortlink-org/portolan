{
  "type": "record",
  "namespace": "shop.oms",
  "name": "OrderPlaced",
  "fields": [
    { "name": "order_id", "type": "string" },
    { "name": "buyer", "type": "shop.oms.Party" },
    { "name": "labels", "type": { "type": "map", "values": "string" } },
    { "name": "placed_at", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "total", "type": "long" }
  ]
}
