          "kind": "broker",
          "context": null,
          "label": "Watermill · mail.output"
        }
      ],
      "steps": [
        {
          "type": "step",
          "id": "receive",
          "from": "watermill.mail-input",
          "to": "sales.mailer",
          "kind": "event",
          "label": "mail_router",
          "status": "declared",
          "note": "Input `Input`: `id string`, `valid bool`. Consumer group `mail-workers`.",
          "line": "app/router.go:26",
          "handoff": {
            "kind": "message",
            "transport": "watermill",
            "channel": "mail.input",
            "direction": "receive"
          }
        },
        {
          "type": "alt",
          "id": "outcome",
          "branches": [
            {
              "title": "!input.Valid",
              "steps": [
                {
                  "type": "step",
                  "id": "publish-1",
                  "from": "sales.mailer",
                  "to": "watermill.mail-error",
                  "kind": "event",
                  "label": "publish Failure",
                  "status": "declared",
                  "note": "Payload `Failure`: `reason string`.",
                  "line": "app/router.go:30",
                  "handoff": {
                    "kind": "message",
                    "transport": "watermill",
                    "channel": "mail.error",
                    "direction": "send"
                  }
                }
              ],
              "terminal": true
            },
            {
              "title": "not (!input.Valid)",
              "steps": [
                {
                  "type": "step",
                  "id": "publish-2",
                  "from": "sales.mailer",
                  "to": "watermill.mail-output",
                  "kind": "event",
                  "label": "publish Output",
                  "status": "declared",
                  "note": "Payload `Output`: `accepted bool`.",
                  "line": "app/router.go:36",
                  "handoff": {
