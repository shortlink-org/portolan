<Project Sdk="Microsoft.NET.Sdk">

  <!-- A C# tree laid out by module and layer in, a catalog fragment out.
       Roslyn is the parser: the compiler's own, so the tree is always the
       whole language, and a Compilation over the service's own files gives
       the semantic model that resolves partial classes, base chains and the
       type of an expression. No package of the service is ever restored:
       what its NuGet dependencies declare stays an error type with a name,
       and a name is what the reading rules go by. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>portolan-extract-csharp-ddd</AssemblyName>
    <RootNamespace>Portolan.Extract.CSharp</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test/**;testdata/**;bin/**;obj/**" />
    <EmbeddedResource Include="options.schema.json" LogicalName="options.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
