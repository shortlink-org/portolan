<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reader, held to a fixture. No test framework: the plugin has one
       dependency and a runner would be a second. Run it with `dotnet run` on
       this project, from anywhere in the repository; UPDATE_GOLDEN=1 writes
       the expected files again after a deliberate change, and the diff is the
       review. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>portolan-extract-csharp-ddd-test</AssemblyName>
    <RootNamespace>Portolan.Extract.CSharp.Test</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../portolan-extract-csharp-ddd.csproj" />
  </ItemGroup>

</Project>
