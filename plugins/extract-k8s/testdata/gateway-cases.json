{
  "cases": [
    {
      "name": "exact route hostname intersects a wildcard listener",
      "backends": ["shop/pricing"],
      "want": ["api.example.com"],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "public", "namespace": "shop" },
          "spec": { "listeners": [{ "name": "web", "protocol": "HTTPS", "port": 443, "hostname": "*.example.com" }] }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "shop" },
          "spec": {
            "parentRefs": [{ "name": "public" }],
            "hostnames": ["api.example.com", "elsewhere.test"],
            "rules": [{ "backendRefs": [{ "name": "pricing" }] }]
          }
        }
      ]
    },
    {
      "name": "route without hostnames inherits a concrete listener hostname",
      "backends": ["shop/pricing"],
      "want": ["api.example.com"],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "public", "namespace": "shop" },
          "spec": { "listeners": [{ "name": "web", "protocol": "HTTP", "port": 80, "hostname": "api.example.com" }] }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "shop" },
          "spec": {
            "parentRefs": [{ "name": "public" }],
            "rules": [{ "backendRefs": [{ "name": "pricing", "kind": "Service" }] }]
          }
        }
      ]
    },
    {
      "name": "a route with no matching listener contributes no hostname",
      "backends": ["shop/pricing"],
      "want": [],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "public", "namespace": "shop" },
          "spec": { "listeners": [{ "name": "web", "protocol": "HTTP", "port": 80, "hostname": "shop.example.com" }] }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "shop" },
          "spec": {
            "parentRefs": [{ "name": "public", "sectionName": "missing" }],
            "hostnames": ["api.example.com"],
            "rules": [{ "backendRefs": [{ "name": "pricing" }] }]
          }
        }
      ]
    },
    {
      "name": "a namespace selector admits a cross namespace route",
      "backends": ["apps/pricing"],
      "want": ["apps.example.com"],
      "objects": [
        {
          "apiVersion": "v1",
          "kind": "Namespace",
          "metadata": { "name": "apps", "labels": { "gateway-access": "public" } }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "shared", "namespace": "infra" },
          "spec": {
            "listeners": [{
              "name": "web",
              "protocol": "HTTPS",
              "port": 443,
              "hostname": "apps.example.com",
              "allowedRoutes": {
                "namespaces": { "from": "Selector", "selector": { "matchLabels": { "gateway-access": "public" } } },
                "kinds": [{ "kind": "HTTPRoute" }]
              }
            }]
          }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "apps" },
          "spec": {
            "parentRefs": [{ "name": "shared", "namespace": "infra", "sectionName": "web", "port": 443 }],
            "rules": [{ "backendRefs": [{ "name": "pricing" }] }]
          }
        }
      ]
    },
    {
      "name": "a cross namespace backend requires a ReferenceGrant",
      "backends": ["shop/pricing"],
      "want": ["cross.example.com"],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "public", "namespace": "routes" },
          "spec": { "listeners": [{ "name": "web", "protocol": "HTTP", "port": 80, "hostname": "cross.example.com" }] }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "routes" },
          "spec": {
            "parentRefs": [{ "name": "public" }],
            "rules": [{ "backendRefs": [{ "name": "pricing", "namespace": "shop" }] }]
          }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1beta1",
          "kind": "ReferenceGrant",
          "metadata": { "name": "routes-to-pricing", "namespace": "shop" },
          "spec": {
            "from": [{ "group": "gateway.networking.k8s.io", "kind": "HTTPRoute", "namespace": "routes" }],
            "to": [{ "group": "", "kind": "Service", "name": "pricing" }]
          }
        }
      ]
    },
    {
      "name": "a cross namespace backend without a ReferenceGrant is ignored",
      "backends": ["shop/pricing"],
      "want": [],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "public", "namespace": "routes" },
          "spec": { "listeners": [{ "name": "web", "protocol": "HTTP", "port": 80, "hostname": "cross.example.com" }] }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "routes" },
          "spec": {
            "parentRefs": [{ "name": "public" }],
            "rules": [{ "backendRefs": [{ "name": "pricing", "namespace": "shop" }] }]
          }
        }
      ]
    },
    {
      "name": "listener and route hostnames must intersect",
      "backends": ["shop/pricing"],
      "want": [],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "Gateway",
          "metadata": { "name": "public", "namespace": "shop" },
          "spec": { "listeners": [{ "name": "web", "protocol": "HTTPS", "port": 443, "hostname": "shop.example.com" }] }
        },
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "shop" },
          "spec": {
            "parentRefs": [{ "name": "public" }],
            "hostnames": ["api.example.com"],
            "rules": [{ "backendRefs": [{ "name": "pricing" }] }]
          }
        }
      ]
    },
    {
      "name": "an unattached route is not an ingress",
      "backends": ["shop/pricing"],
      "want": [],
      "objects": [
        {
          "apiVersion": "gateway.networking.k8s.io/v1",
          "kind": "HTTPRoute",
          "metadata": { "name": "pricing", "namespace": "shop" },
          "spec": {
            "hostnames": ["false-positive.example.com"],
            "rules": [{ "backendRefs": [{ "name": "pricing" }] }]
          }
        }
      ]
    }
  ]
}
