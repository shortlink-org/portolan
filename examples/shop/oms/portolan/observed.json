                          "doc": ""
                        },
                        {
                          "name": "quoteId",
                          "type": "string",
                          "doc": ""
                        },
                        {
                          "name": "occurredAt",
                          "type": "Date",
                          "doc": ""
                        }
                      ]
                    }
                  ],
                  "consumers": [
                    {
                      "service": "shop.oms",
                      "status": "verified",
                      "note": "Seen consuming it in telemetry/traces.jsonl."
                    }
                  ]
                }
              ]
            }
