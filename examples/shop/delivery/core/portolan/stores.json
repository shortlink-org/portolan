          "id": "delivery.core.pg.mv_route_load",
          "name": "mv_route_load",
          "materialized": true,
          "columns": [
            {
              "name": "route_id",
              "type": "text",
              "nullable": false,
              "from": [
                "delivery.core.pg.routes.id"
              ],
              "maps": "Route.id"
            },
            {
              "name": "vehicle",
              "type": "text",
