            },
            {
              "name": "done",
              "type": "integer",
              "nullable": false,
              "from": [
                "delivery.core.pg.route_stops.seq"
              ],
              "maps": "Route.stops.seq"
            }
          ],
          "reads": [
            "delivery.core.pg.routes",
            "delivery.core.pg.route_stops"
          ],
          "definition": "CREATE MATERIALIZED VIEW mv_route_load AS\nSELECT r.id          AS route_id,\n       r.vehicle     AS vehicle,\n       r.planned_for AS planned_for,\n       count(s.seq)  AS stops,\n       count(s.seq) FILTER (WHERE s.done) AS done\n  FROM routes r\n  LEFT JOIN route_stops s ON s.route_id = r.id\n GROUP BY r.id;",
          "persists": {
            "aggregate": "delivery.core.route"
          },
          "source": "src/infrastructure/repository/route/migrations/0002_route_load.sql"
        }
