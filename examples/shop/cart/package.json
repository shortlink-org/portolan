{
  "name": "cart",
  "private": true,
  "version": "0.1.0",
  "description": "Shopping Cart — service `cart` of bounded context `shop`",
  "type": "module",
  "repository": "git+https://github.com/shortlink-org/portolan.git",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/infrastructure/repository/basket && cp -R src/infrastructure/repository/basket/migrations dist/infrastructure/repository/basket/",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "npm run generate:api && npm run generate:auth && npm run generate:pricing",
    "generate:api": "openapi-typescript src/infrastructure/transport/http/gen/openapi.yaml -o src/infrastructure/transport/http/gen/types.ts",
    "generate:auth": "openapi-typescript src/infrastructure/auth/gen/openapi.yaml -o src/infrastructure/auth/gen/types.ts",
    "generate:pricing": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "fastify": "6.0.0-alpha.5",
    "inversify": "^8.2.3",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.0",
    "openapi-typescript": "^7.13.0",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
